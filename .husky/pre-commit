if ! command -v npm >/dev/null 2>&1; then
  NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  if [ -s "$NVM_DIR/nvm.sh" ]; then
    . "$NVM_DIR/nvm.sh"
  fi
fi

if ! command -v npm >/dev/null 2>&1; then
  echo "pre-commit: npm was not found. Install Node.js or make it available in PATH." >&2
  exit 127
fi

npm run check:staged
npm run check-types

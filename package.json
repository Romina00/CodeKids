{
  "name": "codekids",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "turbo run check-types",
    "test": "npm run test --workspace @codekids/backend -- --runInBand",
    "check:staged": "node scripts/check-staged-console.mjs && lint-staged",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.7.4",
    "turbo": "^2.10.2",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.8.0",
  "lint-staged": {
    "{apps,packages}/**/*.{ts,tsx,js,mjs,cjs}": "eslint --max-warnings 0",
    "*.{ts,tsx,js,mjs,cjs,json,md,css}": "prettier --check"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
